{
  "name": "jnv-teacher-routine-portal",
  "version": "1.0.0",
  "private": true,
  "description": "JNV Teacher Routine Portal - upload, OCR-extract, review and publish school routines",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "node scripts/dev-db.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "sample": "node scripts/make-sample.mjs",
    "e2e": "node scripts/e2e.mjs",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:restore": "node scripts/restore-data.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@napi-rs/canvas": "^0.1.65",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.26",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}