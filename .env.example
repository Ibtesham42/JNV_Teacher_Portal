# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://jnv:jnv_local_password@localhost:5433/jnv_routine"

# ---- Auth.js ----
# generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true
# public URL of the site (used by Auth.js behind a proxy)
AUTH_URL="http://localhost:3000"

# ---- First admin account (created/updated by `npm run db:seed`) ----
ADMIN_USERNAME="admin"
ADMIN_NAME="Portal Administrator"
ADMIN_PASSWORD="ChangeThisPassword!123"

# ---- School ----
SCHOOL_TZ="Asia/Kolkata"
# comma separated; used to validate extracted class names / sections
SCHOOL_CLASSES="VI,VII,VIII,IX,X,XI,XII"
SCHOOL_SECTIONS="A,B,C,D,E,F"

# ---- File storage ----
STORAGE_DIR="./.data/uploads"
MAX_UPLOAD_MB=25

# ---- OCR ----
TESSDATA_DIR="./.data/tessdata"
OCR_LANG="eng"
MAX_EXTRACT_PAGES=30

# ---- AI structured extraction (optional but strongly recommended for scanned documents) ----
# Leave empty to use the built-in rule-based reader on the OCR output.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---- Free AI help via Groq (text model: fixes OCR misreadings, structures unfamiliar layouts) ----
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# ---- Vercel / serverless (see DEPLOY_VERCEL.md) ----
# STORAGE_DRIVER=db          # keep uploaded originals in PostgreSQL instead of a local folder
# MAX_UPLOAD_MB=4            # Vercel rejects request bodies above ~4.5 MB
# TESSDATA_DIR=/tmp/tessdata # the only writable folder on Vercel
# DIRECT_URL=                # non-pooled Neon URL, used for migrations during the build
